+  const cancelSession = (
+    sessionId: string,
+    reason: TerminationReason = "manual-cancel",
+  ): number => {
+    const normalizedSessionId = sessionId.trim();
+    if (!normalizedSessionId) {
+      return 0;
+    }
+    let cancelled = 0;
+    for (const [runId, run] of active.entries()) {
+      if (run.sessionId !== normalizedSessionId) {
+        continue;
+      }
+      cancel(runId, reason);
+      cancelled += 1;
+    }
+    return cancelled;
+  };
