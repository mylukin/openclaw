+  const response = await fetch(`http://127.0.0.1:${params.port}/mcp`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      ...params.headers,
+    },
+    body: JSON.stringify(params.body),
+  });
+  return await response.json();
+}
+
+describe("mcp-http", () => {
