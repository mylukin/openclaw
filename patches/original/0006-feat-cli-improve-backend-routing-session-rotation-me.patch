+  const mergedHash = crypto.createHash("sha256").update(mergedContent).digest("hex").slice(0, 16);
+  const mergedPath = path.join(
+    path.dirname(defaultMcpConfigPath),
+    `mcp.cli-merged.${mergedHash}.json`,
