+export function resolveBootstrapTotalMaxChars(
+  cfg?: OpenClawConfig,
+  contextWindowTokens?: number,
+): number {
   const raw = cfg?.agents?.defaults?.bootstrapTotalMaxChars;
   if (typeof raw === "number" && Number.isFinite(raw) && raw > 0) {
