+  it("accepts memory/YYYY-MM-DD.md only when parent dir is 'memory'", () => {
+    expect(isCompactableFile("/workspace/archive/2026-03-07.md")).toBe(false);
+    expect(isCompactableFile("/workspace/memory/2026-03-07.md")).toBe(true);
+  });
+});
