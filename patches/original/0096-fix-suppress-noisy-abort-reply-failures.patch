+      err.name = "AbortError";
+      throw err;
+    });
+
+    const { run } = createMinimalRun();
+    const res = await run();
+
+    expect(res).toBeUndefined();
+  });
+
   it("still replies even if session reset fails to persist", async () => {
     await withTempStateDir(async (stateDir) => {
       const saveSpy = vi
