From 18f3e0e654312547881780bf7ebeb187fec0740d Mon Sep 17 00:00:00 2001
From: Lukin <mylukin@gmail.com>
Date: Tue, 24 Mar 2026 13:22:20 +0800
Subject: [PATCH 35/98] feat(feishu): add cardHeader/cardNote config flags and
 fix card at-mention rendering

- Add `cardHeader` and `cardNote` boolean config options to FeishuSharedConfigShape
  (default: true). When set to false, card title and footer note are omitted.
- Fix missing normalizeMentionTagsForCard() call in sendStructuredCardFeishu(),
  which caused <at user_id="..."> tags from hooks to render as invisible in cards.
  The correct card format is <at id=...>.

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 extensions/feishu/src/config-schema.ts    |  2 ++
 extensions/feishu/src/reply-dispatcher.ts | 18 +++++++++++++-----
 extensions/feishu/src/send.ts             |  4 ++--
 3 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/extensions/feishu/src/config-schema.ts b/extensions/feishu/src/config-schema.ts
index 899bd44de7..acee4e852b 100644
--- a/extensions/feishu/src/config-schema.ts
+++ b/extensions/feishu/src/config-schema.ts
@@ -194,6 +194,8 @@ const FeishuSharedConfigShape = {
