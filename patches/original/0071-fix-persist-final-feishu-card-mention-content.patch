+    const result = await sendText({
+      cfg: {
+        channels: {
+          feishu: {
+            renderMode: "card",
+          },
+        },
+      } as any,
+      to: "chat_1",
+      text: '<at user_id="ou_123">Emma</at> hello',
+      accountId: "main",
+    });
