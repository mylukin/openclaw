+    expect(result).toEqual(
+      expect.objectContaining({
+        channel: "feishu",
+        messageId: "card_msg",
+        meta: {
+          contentType: "interactive",
+          finalContent: "<at id=ou_123></at> hello",
+        },
+      }),
+    );
   });
 
