+++        data: {
+++          phase: "result",
+++          ...(payload.toolUseId ? { toolUseId: payload.toolUseId } : {}),
+++          ...(payload.text ? { result: payload.text, partialResult: payload.text } : {}),
+++          ...(payload.isError ? { isError: true } : {}),
+++        },
+++      });
+++    },
+++  });
+++}
