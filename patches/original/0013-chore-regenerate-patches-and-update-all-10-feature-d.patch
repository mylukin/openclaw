+++  }
+++  // Match memory/YYYY-MM-DD.md pattern
+++  if (/^20\d{2}-\d{2}-\d{2}\.md$/.test(basename)) {
+++    const dir = path.basename(path.dirname(filePath));
+++    return dir === "memory";
+++  }
+++  return false;
+++}
