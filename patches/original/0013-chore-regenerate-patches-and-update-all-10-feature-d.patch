+++    .join("\n");
+++}
+++
+++function emitAgentEvent(
+++  cb: RunEmbeddedPiAgentParams["onAgentEvent"],
+++  event: { stream: string; data: Record<string, unknown> },
+++): void {
+++  if (!cb) {
+++    return;
+++  }
+++  cb(event);
+++}
