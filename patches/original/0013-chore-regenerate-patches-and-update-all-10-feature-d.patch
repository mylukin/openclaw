+++      .finally(() => {
+++        guard.dispose();
+++      });
+++  });
+++  httpServers.set(accountId, server);
+++
+++  return new Promise((resolve, reject) => {
+++    const cleanup = () => {
+++      server.close();
+++      httpServers.delete(accountId);
+++      botOpenIds.delete(accountId);
+++    };
