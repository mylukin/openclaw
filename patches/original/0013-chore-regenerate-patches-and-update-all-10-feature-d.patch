+++  if (abortSignal) {
+++    abortSignal.addEventListener(
+++      "abort",
+++      () => {
+++        threadBindingManager.stop();
+++        log(`feishu[${accountId}]: thread binding adapter stopped`);
+++      },
+++      { once: true },
+++    );
+++  }
