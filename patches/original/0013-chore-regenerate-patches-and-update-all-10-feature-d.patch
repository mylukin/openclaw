+++    parentId: params.parentId,
+++    accountId: params.accountId,
+++    chatId: params.chatId,
+++  });
+++}
+++
+++function readQuotedContentFromSession(params: {
+++  storePath: string;
+++  agentId?: string;
+++  sessionKey: string;
+++  parentId: string;
+++  accountId?: string;
+++  chatId: string;
+++}): string | undefined {
+++  const sessionFile = resolveTranscriptPath({
+++    storePath: params.storePath,
+++    agentId: params.agentId,
+++    sessionKey: params.sessionKey,
+++  });
+++  if (!sessionFile || !fs.existsSync(sessionFile)) {
+++    return undefined;
+++  }
+++
+++  let raw: string;
+++  try {
+++    raw = fs.readFileSync(sessionFile, "utf-8");
+++  } catch {
+++    return undefined;
+++  }
+++  if (!raw.trim()) {
+++    return undefined;
+++  }
+++
+++  const entries = raw
+++    .split("\n")
+++    .filter((line) => line.trim())
+++    .map((line) => {
+++      try {
+++        return JSON.parse(line);
+++      } catch {
+++        return null;
+++      }
+++    })
+++    .filter(Boolean);
+++
+++  return findQuotedContentInEntries(entries, {
+++    parentId: params.parentId,
+++    accountId: params.accountId,
+++    chatId: params.chatId,
+++  });
+++}
+++
+++function resolveBotCompanyDbPath(cfg: ClawdbotConfig, override?: string): string | undefined {
