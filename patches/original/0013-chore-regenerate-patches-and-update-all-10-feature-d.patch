+++  DEFAULT_FEISHU_THREAD_BINDING_IDLE_TIMEOUT_MS,
+++  DEFAULT_FEISHU_THREAD_BINDING_MAX_AGE_MS,
+++  FEISHU_THREAD_BINDINGS_SWEEP_INTERVAL_MS,
+++  FEISHU_THREAD_BINDING_TOUCH_PERSIST_MIN_INTERVAL_MS,
