+++        `mcp: loopback server listening on 127.0.0.1:${port} (${initial.length} tools, ttl=${TOOL_CACHE_TTL_MS}ms)`,
+++      );
+++      resolve();
+++    });
+++  });
+++
+++  return {
+++    close: () =>
+++      new Promise<void>((resolve, reject) => {
+++        httpServer.close((err) => (err ? reject(err) : resolve()));
+++      }),
+++  };
+++}
