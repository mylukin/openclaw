+++    const guard = installRequestBodyLimitGuard(req, res, {
+++      maxBytes: FEISHU_WEBHOOK_MAX_BODY_BYTES,
+++      timeoutMs: FEISHU_WEBHOOK_BODY_TIMEOUT_MS,
+++      responseFormat: "text",
