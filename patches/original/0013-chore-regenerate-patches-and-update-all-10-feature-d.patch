+++    server.listen(port, host, () => {
+++      log(`feishu[${accountId}]: Webhook server listening on ${host}:${port}`);
+++    });
+++
+++    server.on("error", (err) => {
+++      error(`feishu[${accountId}]: Webhook server error: ${err}`);
+++      abortSignal?.removeEventListener("abort", handleAbort);
+++      reject(err);
+++    });
+++  });
+++}
