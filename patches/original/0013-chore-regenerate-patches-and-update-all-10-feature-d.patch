+++    }
+++    void Promise.resolve(webhookHandler(req, res))
+++      .catch((err) => {
+++        if (!guard.isTripped()) {
+++          error(`feishu[${accountId}]: webhook handler error: ${String(err)}`);
+++        }
+++      })
+++      .finally(() => {
+++        guard.dispose();
+++      });
+++  });
+++  httpServers.set(accountId, server);
+++
+++  return new Promise((resolve, reject) => {
+++    const cleanup = () => {
+++      server.close();
