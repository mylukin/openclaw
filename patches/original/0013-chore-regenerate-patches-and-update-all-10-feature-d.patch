+++  bind: (params: FeishuBindParams) => Promise<FeishuThreadBindingRecord | null>;
+++  unbind: (
+++    chatId: string,
+++    rootId: string,
+++    opts?: { reason?: string; sendFarewell?: boolean; farewellText?: string },
