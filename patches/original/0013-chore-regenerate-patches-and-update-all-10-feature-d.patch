+++    cliSessionId: params.cliSessionId,
+++    images: params.images,
+++    abortSignal: params.abortSignal,
+++    trigger: params.trigger,
+++    messageChannel,
+++    onAssistantTurn: (text) => {
+++      if (text.trim()) {
+++        void params.onPartialReply?.({ text });
+++      }
+++      emitAgentEvent(params.onAgentEvent, {
+++        stream: "assistant",
+++        data: { text },
+++      });
+++    },
