+++    accountId?: string;
+++    messageTo?: string;
+++    messageThreadId?: string;
+++  }) {
+++    if (toolCacheConfigRef && toolCacheConfigRef !== params.cfg) {
+++      toolCache.clear();
+++    }
+++    toolCacheConfigRef = params.cfg;
+++    const cacheKey = [
+++      params.sessionKey,
+++      params.messageProvider ?? "",
+++      params.accountId ?? "",
+++      params.messageTo ?? "",
+++      params.messageThreadId ?? "",
