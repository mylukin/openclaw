+++function resolveManagersMap(): Map<string, FeishuThreadBindingManager> {
+++  const g = globalThis as typeof globalThis & {
+++    [MANAGERS_KEY]?: Map<string, FeishuThreadBindingManager>;
+++  };
+++  if (!g[MANAGERS_KEY]) {
+++    g[MANAGERS_KEY] = new Map();
+++  }
+++  return g[MANAGERS_KEY];
+++}
