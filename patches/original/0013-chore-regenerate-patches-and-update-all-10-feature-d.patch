+++  const updatedContextFiles = contextFiles.map((f) => {
+++    if (compactableSet.has(f.path) && compactedMap.has(f.path)) {
+++      return { ...f, content: compactedMap.get(f.path) as string };
+++    }
+++    return f;
+++  });
+++
+++  return { contextFiles: updatedContextFiles, results };
+++}
