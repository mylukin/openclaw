++  1. nodeId="node-abc" 精确匹配 ✓  -> 使用 overrides["node-abc"]
++  2. displayName="my-display" (跳过, 已有更高优先级匹配)
++  3. nodeId 前缀 "node-" (跳过)
++
++  最终结果:
++  allow = PLATFORM_DEFAULTS + [A] + [C]
++  deny  = [B] + [D]
++  有效集 = allow - deny
