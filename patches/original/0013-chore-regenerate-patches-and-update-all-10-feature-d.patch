+++      raw = flattenUnionSchema(raw);
+++    }
+++    if (raw.type !== "object") {
+++      raw.type = "object";
+++      if (!raw.properties) {
+++        raw.properties = {};
+++      }
+++    }
+++    return { name: t.name, description: t.description, inputSchema: raw };
+++  });
