             mediaUrl,
@@ -198,6 +213,7 @@ export const feishuOutbound: ChannelOutboundAdapter = {
             mediaLocalRoots,
             replyToMessageId,
           });
+          return attachFeishuMediaMetadata(sent, mediaUrl);
         } catch (err) {
           // Log the error for debugging
           console.error(`[feishu] sendMediaFeishu failed:`, err);
