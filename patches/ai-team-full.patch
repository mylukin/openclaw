+          content: [{ type: "text", text: `ok-${marker}` }],
+        }),
+      },
+    ];
+  },
+}));
+
+vi.mock("../agents/pi-tools.policy.js", () => ({
+  resolveEffectiveToolPolicy: () => ({
+    agentId: "main",
