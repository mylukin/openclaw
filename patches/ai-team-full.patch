+    DEFAULT_BOOTSTRAP_TOTAL_MAX_CHARS,
+    Math.max(20_000, Math.floor(available * 4)),
+  );
+  return {
+    maxCharsPerFile: DEFAULT_BOOTSTRAP_MAX_CHARS,
+    totalMaxChars: bootstrapTotalMaxChars,
+  };
+}
