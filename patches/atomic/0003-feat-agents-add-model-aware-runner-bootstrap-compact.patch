+          defaults: {
+            imageModel: {
+              fallbacks: [],
+            },
+          },
+        },
+      },
+    });
+
+    expect(result).toBe(false);
+  });
+
+  it("returns false when config is undefined", () => {
+    const result = shouldUseImagePreAnalysis({
+      config: undefined,
+    });
+
+    expect(result).toBe(false);
+  });
+
+  it("returns false when agents.defaults is undefined", () => {
+    const result = shouldUseImagePreAnalysis({
+      config: {
+        agents: {},
+      },
+    });
+
+    expect(result).toBe(false);
