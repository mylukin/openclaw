+  it("register() exposes native feishu dispatcher on runtime.channel.reply", async () => {
+    const mod = await import("../index.js");
+    const register = mod.default.register as (api: unknown) => void;
+    const runtime = {
+      channel: {
+        reply: {},
+      },
