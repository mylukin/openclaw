+      const toolUseEvents = isAssistantEnvelope ? extractToolUseEvents(contentBlocks) : [];
+      const allowToolResultEvents = isToolResultAllowedEnvelope({
+        isAssistantEnvelope,
+        type,
+        messageRole,
