@@ -0,0 +1,213 @@
+import { describe, expect, it } from "vitest";
+import type { SessionEntry } from "../config/sessions.js";
+import {
+  clearAllCliSessions,
+  clearCliSession,
+  getCliSessionBinding,
+  getCliSessionId,
