+type NodeCommandConfigEntry = {
+  path: string;
+  values: string[];
+  overrideKey?: string;
+};
+
+function formatNodeOverrideConfigPath(
+  key: string,
+  field: "allowCommands" | "denyCommands",
+): string {
+  return `gateway.nodes.overrides[${JSON.stringify(key)}].${field}`;
