@@ -21,23 +21,34 @@ function dedupeChannels(channels: ChannelPlugin[]): ChannelPlugin[] {
 
 type CachedChannelPlugins = {
   registryVersion: number;
+  sourceSignature: string;
   sorted: ChannelPlugin[];
   byId: Map<string, ChannelPlugin>;
