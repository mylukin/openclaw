+      ? Number.isFinite(raw)
+        ? Math.floor(raw)
+        : undefined
+      : typeof raw === "string"
+        ? Number.parseInt(raw, 10)
+        : undefined;
+  if (typeof parsed !== "number" || Number.isNaN(parsed) || parsed <= 0) {
+    return DEFAULT_LLM_SLUG_TIMEOUT_MS;
+  }
+  return clampNumber(parsed, MIN_LLM_SLUG_TIMEOUT_MS, MAX_LLM_SLUG_TIMEOUT_MS);
+}
 
